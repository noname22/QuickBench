*.pyc
.venv/

# The private problem set lives in its own private repository, mounted as a
# submodule at problems/private/ (see .gitmodules).

# Model output and grader rationales restate the private questions.
# summary.json (scores only) stays publishable.
results/*/responses/private/
results/*/grades/private/

# Run logs
results/*.log
